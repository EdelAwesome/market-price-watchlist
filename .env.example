# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Web server ---
PORT=3000
NODE_ENV=development
# 32+ random bytes; used to sign the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Session-cookie Secure flag. Defaults to TRUE when unset (production/HTTPS). Set false ONLY for
# local http development/compose, or the browser won't send the cookie back over http.
COOKIE_SECURE=false

# --- Postgres ---
# Shape: postgres://USER:PASSWORD@HOST:PORT/DB
# Local dev verified with Homebrew postgresql@16:
#   brew install postgresql@16 && brew services start postgresql@16
#   psql -d postgres -c "CREATE ROLE mpw LOGIN PASSWORD 'mpw';" && createdb -O mpw mpw
# (docker-compose uses the same mpw/mpw/mpw, so this URL works against either.)
DATABASE_URL=postgres://mpw:mpw@localhost:5432/mpw

# --- Redis (queue on db 0, cache on db 1 — kept separate so cache eviction can't drop jobs) ---
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_DB=0
REDIS_CACHE_DB=1

# --- Alpaca Market Data (free/Basic key — QUOTES ONLY, IEX feed) ---
# Create at https://alpaca.markets (paper account is fine for market data).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_FEED=iex

# --- Quote layer ---
QUOTE_TTL_SECONDS=60
# Strict bound for ALERT evaluation: skip (never email) if quote older than this.
ALERT_STALENESS_SECONDS=90
# Lenient bound for DISPLAY: serve last-known but flag stale in UI beyond this.
DISPLAY_STALENESS_SECONDS=300

# --- Email (Resend) — used from slice 5 ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com
